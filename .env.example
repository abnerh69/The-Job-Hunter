# Job Hunter EU Configuration Example
# Copy this file to .env and fill in the values

# Database connection string (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./jobhunter.db

# LLM Provider: anthropic | gemini | agy_cli | mock
LLM_PROVIDER=gemini

# Anthropic API Key (Required if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-xxxx...

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# Antigravity CLI (Used if LLM_PROVIDER=agy_cli on remote server)
AGY_CLI_BIN=agy
AGY_MODEL=gemini-4-hydrogen-medium

# Dashboard Password (Required)
DASHBOARD_PASSWORD=changeme

# Optional: External candidate profile YAML/MD for multi-client / DFY usage
# CANDIDATE_PROFILE_PATH=profiles/default.yaml

# Telegram Bot configuration for notifications (Optional)
# TELEGRAM_BOT_TOKEN=123456789:ABCDefgh...
# TELEGRAM_CHAT_ID=123456789

# SMTP configuration for email digests (Optional)
# SMTP_USER=user@example.com
# SMTP_PASSWORD=your-smtp-password
# DIGEST_TO_EMAIL=recipient@example.com
