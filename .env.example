# Job Hunter EU Configuration Example
# Copy this file to .env and fill in the values

# Database connection string
DATABASE_URL=sqlite:///./jobhunter.db

# Anthropic API Key for job scoring (Required)
ANTHROPIC_API_KEY=sk-ant-xxxx...

# Telegram Bot configuration for notifications (Optional)
TELEGRAM_BOT_TOKEN=123456789:ABCDefgh...
TELEGRAM_CHAT_ID=123456789

# SMTP configuration for email digests (Optional)
SMTP_USER=user@example.com
SMTP_PASSWORD=your-smtp-password
DIGEST_TO_EMAIL=recipient@example.com
